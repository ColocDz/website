generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models (required by Better Auth) ───

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  emailVerified     Boolean   @default(false)
  image             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Extended profile fields for ColocDZ
  lastName          String?
  phone             String?
  gender            String?
  birthday          DateTime?
  bio               String?   @db.Text
  wilaya            String?
  city              String?
  isPrivate         Boolean   @default(false)
  nameChanged       Boolean   @default(false)
  isArchived        Boolean   @default(false)
  identityVerified  Boolean   @default(false)
  faceVerified      Boolean   @default(false)
  faceVerifiedAt    DateTime?
  faceVerifiedUntil DateTime?
  faceImage         String?   @db.Text
  faceDescriptor    Json?     // Array of 128 numbers
  password          String?
  phoneOtp          String?
  phoneOtpExpiry    DateTime?
  phoneVerified     Boolean   @default(false)
  savedPostIds      Json?     // Array of post IDs

  // Relations
  sessions          Session[]
  accounts          Account[]
  posts             Post[]
  sentMessages      Message[]        @relation("SentMessages")
  comments          Comment[]

  @@index([createdAt])
  @@index([isArchived])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Application Models ───

model Post {
  id          String   @id @default(cuid())
  title       String
  type        String   // Apartment, House, Studio, Room, Shared Space
  postType    String   // offer, request
  searchType  String   @default("roommate") // "roommate" = has place, "roommate_and_place" = needs both
  description String   @db.Text
  price       String?
  maxBudget   String?  // For roommate_and_place posts: max affordable rent
  location    String?
  wilaya      String?
  bedrooms    Int?
  bathrooms   Int?
  amenities   Json?    // Array of amenities
  necessities Json?    // Array of necessities
  tags        Json?    // Array of tags
  images      Json?    // Array of image URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      String   @default("published") // published or draft
  isArchived  Boolean  @default(false)

  // Author relation
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]

  @@index([status, isArchived, createdAt])
  @@index([status, isArchived, createdAt, id])
  @@index([authorId, isArchived])
  @@index([wilaya, status, isArchived])
}

model Conversation {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  participantIds Json?     // Array of user IDs
  archivedBy     Json?     // Array of user IDs
  messages       Message[]

  @@index([updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  // Sender
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  // Conversation
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String   @db.Text
  createdAt DateTime @default(now())

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String
  timestamp DateTime @default(now())

  @@index([key, timestamp])
}
