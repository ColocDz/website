generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models (required by Better Auth for MySQL) ───

model User {
  id                String    @id @default(cuid())
  name              String    @db.VarChar(255)
  email             String    @unique @db.VarChar(255)
  emailVerified     Boolean   @default(false)
  image             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Extended profile fields for ColocDZ
  lastName          String?   @db.VarChar(255)
  phone             String?   @db.VarChar(255)
  gender            String?   @db.VarChar(50)
  birthday          DateTime?
  bio               String?   @db.Text
  wilaya            String?   @db.VarChar(255)
  city              String?   @db.VarChar(255)
  isPrivate         Boolean   @default(false)
  nameChanged       Boolean   @default(false)
  isArchived        Boolean   @default(false)
  identityVerified  Boolean   @default(false)
  faceVerified      Boolean   @default(false)
  faceVerifiedAt    DateTime?
  faceVerifiedUntil DateTime?
  faceImage         String?   @db.Text
  faceDescriptor    Json?
  password          String?   @db.Text
  phoneOtp          String?   @db.VarChar(50)
  phoneOtpExpiry    DateTime?
  phoneVerified     Boolean   @default(false)
  savedPostIds      Json?

  // Relations
  sessions          Session[]
  accounts          Account[]
  posts             Post[]
  sentMessages      Message[]        @relation("SentMessages")
  conversations     Conversation[]   @relation("UserConversations")
  comments          Comment[]

  @@index([createdAt])
  @@index([isArchived])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(255)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(255)
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Application Models ───

model Post {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  type        String   @db.VarChar(100) // Apartment, House, Studio, Room, Shared Space
  postType    String   @db.VarChar(100) // offer, request
  searchType  String   @default("roommate") @db.VarChar(100) // "roommate" or "roommate_and_place"
  description String   @db.Text
  price       String?  @db.VarChar(100)
  maxBudget   String?  @db.VarChar(100)
  location    String?  @db.VarChar(255)
  wilaya      String?  @db.VarChar(255)
  bedrooms    Int?
  bathrooms   Int?
  amenities   Json?
  necessities Json?
  tags        Json?
  images      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      String   @default("published") @db.VarChar(100)
  isArchived  Boolean  @default(false)

  // Author relation
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]

  @@index([status, isArchived, createdAt])
  @@index([status, isArchived, createdAt, id])
  @@index([authorId, isArchived])
  @@index([wilaya, status, isArchived])
}

model Conversation {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Participants
  participants   User[]    @relation("UserConversations")
  participantIds Json?
  archivedBy     Json?
  messages       Message[]

  @@index([updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  // Sender
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  // Conversation
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String   @db.Text
  createdAt DateTime @default(now())

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @db.VarChar(255)
  timestamp DateTime @default(now())

  @@index([key, timestamp])
}
